{
  // The showcase of Mods Config VR's packages: what a package has, each kind on a page of its own, and what a
  // package can get wrong. It grows with the menu: a commit that reads or draws something of a package adds
  // it here.
  // It is an optional file of the mod, for developers. Its values are in showcase.toml and showcase.ini beside it.
  "minSchemaVersion": 1,
  "modName": "ModsConfigVR_Showcase",
  "displayName": "Mods Config VR: Showcase",
  "help": "Every kind of row and setting a package has, to see how each looks and works. Each page is one kind.",
  "packageVersion": 1,
  "files": {
    // shipped beside this config, with a value for each of its settings
    "showcase": { "format": "toml", "root": "data", "path": "ModsConfigVR/Config/ModsConfigVR_Showcase/showcase.toml" },
    // not shipped: its settings have their defaults, and the first Save that changes one creates it
    "player": { "format": "toml", "root": "myGames", "path": "Mods_Config/ModsConfigVR_Showcase/player.toml" },
    "ini": { "format": "ini", "root": "data", "path": "ModsConfigVR/Config/ModsConfigVR_Showcase/showcase.ini" },
    // shipped beside this config, with values that are not the ones of their settings
    "invalid": { "format": "toml", "root": "data", "path": "ModsConfigVR/Config/ModsConfigVR_Showcase/invalid.toml" },
    // left out, with the reason in the log: its path goes up out of its root
    "outside": { "format": "toml", "root": "data", "path": "../showcase.toml" }
  },
  "defaultFile": "showcase",
  "applies": "live",
  // lists of options that several choices use, each named by its own
  "sharedLists": {
    "hands": ["Left", "Right"],
    "places": [
      { "value": "head", "text": "Head" },
      { "value": "chest", "text": "Chest" },
      { "value": "hip", "text": "Hip" }
    ]
  },
  // the front page has one row of every kind, also those the menu does not draw yet, which are placeholders
  // until the commit that draws them
  "content": [
    { "type": "text", "text": "Every kind of row a package has, to see how each looks and works in Mods Config VR. Each page is one kind." },
    { "type": "image", "texture": "ModsConfigVR_Showcase/swatches.dds" },
    { "type": "spacer" },
    {
      "type": "section", "text": "A bit of everything",
      "content": [
        { "type": "text", "text": "A plain text row above the controls." },
        {
          "type": "switcher", "valueType": "bool", "text": "Switcher", "help": "A switcher that is on by default.",
          "default": true, "storage": { "path": ["Main", "bSwitcher"] }
        },
        {
          "type": "slider", "valueType": "float", "text": "Slider", "help": "A slider from 0 to 100 by 5.",
          "default": 50.0, "valueOptions": { "min": 0, "max": 100, "step": 5 },
          "storage": { "path": ["Main", "fSlider"] }
        },
        {
          "type": "slider", "valueType": "int", "text": "Whole number slider", "help": "A slider of whole numbers from 0 to 255.",
          "default": 217, "valueOptions": { "min": 0, "max": 255, "step": 1 },
          "storage": { "path": ["Main", "iSlider"] }
        },
        {
          "type": "stepper", "valueType": "int", "text": "Stepper", "help": "A stepper of three options, which stores the place of the chosen one.",
          "default": 1, "valueOptions": { "options": ["Low", "Medium", "High"] },
          "storage": { "path": ["Main", "iStepper"] }
        },
        {
          "type": "dropdown", "valueType": "string", "text": "Dropdown", "help": "A dropdown of four options, each with the value it stores.",
          "default": "offhand",
          "valueOptions": {
            "options": [
              { "value": "head", "text": "Head", "help": "On the head." },
              { "value": "offhand", "text": "Offhand", "help": "On the hand that does not point." },
              { "value": "primary", "text": "Primary hand", "help": "On the hand that points." },
              { "value": "chest", "text": "Chest", "help": "On the chest." }
            ]
          },
          "storage": { "path": ["Main", "sDropdown"] }
        },
        {
          "type": "textinput", "valueType": "string", "text": "Text input", "help": "A text that is typed.",
          "default": "Hello", "storage": { "path": ["Main", "sText"] }
        },
        {
          "type": "textinput", "valueType": "float", "text": "Number input", "help": "A text input that takes a number.",
          "default": 1.5, "storage": { "path": ["Main", "fNumber"] }
        },
        {
          "type": "button", "text": "Button", "help": "Shows a notification.", "buttonText": "Show",
          "action": { "type": "CallGlobalFunction", "script": "Debug", "function": "Notification", "params": ["Showcase: the button ran"] }
        }
      ]
    }
  ],
  "pages": [
    {
      "pageDisplayName": "Switchers",
      "help": "Switchers, on and off by default.",
      "content": [
        {
          "type": "section", "text": "Switchers",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "On by default", "help": "A switcher that is on by default.",
              "default": true, "storage": { "path": ["Switchers", "bOn"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "Off by default", "help": "A switcher that is off by default.",
              "default": false, "storage": { "path": ["Switchers", "bOff"] }
            },
            {
              "type": "switcher", "text": "No valueType", "help": "A switcher with no valueType, which is a bool as its control is.",
              "default": true, "storage": { "path": ["Switchers", "bNoValueType"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "No help",
              "default": false, "storage": { "path": ["Switchers", "bNoHelp"] }
            },
            {
              "type": "switcher", "valueType": "bool",
              "text": "A switcher with a name that is much too long for the room a row has before its control",
              "help": "Its name ends in an ellipsis, and the help line has all of it.",
              "default": false, "storage": { "path": ["Switchers", "bLongName"] }
            }
          ]
        }
      ]
    },
    {
      "pageDisplayName": "Sliders",
      "help": "Sliders of numbers and of whole numbers, in ranges and steps of each size.",
      "content": [
        {
          "type": "section", "text": "Numbers",
          "content": [
            {
              "type": "slider", "valueType": "float", "text": "From 0 to 1 by 0.05", "help": "A number with two decimals.",
              "default": 0.5, "valueOptions": { "min": 0, "max": 1, "step": 0.05 },
              "storage": { "path": ["Sliders", "fFraction"] }
            },
            {
              "type": "slider", "valueType": "float", "text": "From 0 to 1 by 0.001", "help": "A fine step: the slider has a thousand steps.",
              "default": 0.125, "valueOptions": { "min": 0, "max": 1, "step": 0.001 },
              "storage": { "path": ["Sliders", "fFine"] }
            },
            {
              "type": "slider", "valueType": "float", "text": "From -100 to 100 by 5", "help": "A range below and above zero.",
              "default": -20.0, "valueOptions": { "min": -100, "max": 100, "step": 5 },
              "storage": { "path": ["Sliders", "fNegative"] }
            },
            {
              "type": "slider", "valueType": "float", "text": "From 0 to 10000 by 100", "help": "A large range.",
              "default": 2500.0, "valueOptions": { "min": 0, "max": 10000, "step": 100 },
              "storage": { "path": ["Sliders", "fLarge"] }
            }
          ]
        },
        {
          "type": "section", "text": "Whole numbers",
          "content": [
            {
              "type": "slider", "valueType": "int", "text": "From 0 to 255 by 1", "help": "A whole number, as an opacity is.",
              "default": 217, "valueOptions": { "min": 0, "max": 255, "step": 1 },
              "storage": { "path": ["Sliders", "iOpacity"] }
            },
            {
              "type": "slider", "valueType": "int", "text": "From 1 to 10 by 1", "help": "A short range of whole numbers.",
              "default": 3, "valueOptions": { "min": 1, "max": 10, "step": 1 },
              "storage": { "path": ["Sliders", "iCount"] }
            }
          ]
        }
      ]
    },
    {
      "pageDisplayName": "Choices",
      "help": "Steppers and dropdowns, of their own options and of a shared list, that store a place, a text or a number.",
      "content": [
        {
          "type": "section", "text": "Steppers",
          "content": [
            {
              "type": "stepper", "valueType": "int", "text": "Texts", "help": "Options that are texts: it stores the place of the chosen one.",
              "default": 1, "valueOptions": { "options": ["Low", "Medium", "High"] },
              "storage": { "path": ["Choices", "iStepper"] }
            },
            {
              "type": "stepper", "valueType": "string", "text": "Values", "help": "Options with the text each stores.",
              "default": "normal",
              "valueOptions": {
                "options": [
                  { "value": "slow", "text": "Slow" },
                  { "value": "normal", "text": "Normal" },
                  { "value": "fast", "text": "Fast" }
                ]
              },
              "storage": { "path": ["Choices", "sStepper"] }
            },
            {
              "type": "stepper", "text": "A shared list", "help": "The options of the package's shared list hands. With no valueType it stores a place.",
              "default": 0, "valueOptions": { "sharedOptions": "hands" },
              "storage": { "path": ["Choices", "iHand"] }
            }
          ]
        },
        {
          "type": "section", "text": "Dropdowns",
          "content": [
            {
              "type": "dropdown", "valueType": "int", "text": "Texts", "help": "Options that are texts: it stores the place of the chosen one.",
              "default": 0, "valueOptions": { "options": ["Head", "Offhand", "Primary hand"] },
              "storage": { "path": ["Choices", "iDropdown"] }
            },
            {
              "type": "dropdown", "valueType": "float", "text": "Numbers", "help": "Options with the number each stores.",
              "default": 1.0,
              "valueOptions": {
                "options": [
                  { "value": 0.5, "text": "Half" },
                  { "value": 1.0, "text": "Normal" },
                  { "value": 2.0, "text": "Double" }
                ]
              },
              "storage": { "path": ["Choices", "fScale"] }
            },
            {
              "type": "dropdown", "valueType": "string", "text": "A shared list", "help": "The options of the package's shared list places, with the text each stores.",
              "default": "hip", "valueOptions": { "sharedOptions": "places" },
              "storage": { "path": ["Choices", "sPlace"] }
            },
            {
              "type": "dropdown", "text": "The same shared list", "help": "Another choice of the shared list hands, named in another case.",
              "default": 1, "valueOptions": { "sharedOptions": "Hands" },
              "storage": { "path": ["Choices", "iOtherHand"] }
            },
            {
              "type": "dropdown", "valueType": "int", "text": "Many options", "help": "A list longer than the room under it.",
              "default": 0,
              "valueOptions": { "options": ["One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve"] },
              "storage": { "path": ["Choices", "iMany"] }
            },
            {
              "type": "dropdown", "valueType": "int", "text": "A long option", "help": "An option whose text is much too long for the room of its box.",
              "default": 1,
              "valueOptions": { "options": ["Short", "An option with a text that is much too long for the room its box has"] },
              "storage": { "path": ["Choices", "iLong"] }
            }
          ]
        }
      ]
    },
    {
      "pageDisplayName": "Text inputs",
      "help": "Text inputs of a text, a whole number and a number.",
      "content": [
        {
          "type": "section", "text": "Text inputs",
          "content": [
            {
              "type": "textinput", "valueType": "string", "text": "Text", "help": "A text that is typed.",
              "default": "Hello", "storage": { "path": ["TextInputs", "sText"] }
            },
            {
              "type": "textinput", "valueType": "string", "text": "Empty text", "help": "A text that is empty by default.",
              "default": "", "storage": { "path": ["TextInputs", "sEmpty"] }
            },
            {
              "type": "textinput", "valueType": "int", "text": "Whole number", "help": "A text input that takes a whole number.",
              "default": 42, "storage": { "path": ["TextInputs", "iNumber"] }
            },
            {
              "type": "textinput", "valueType": "float", "text": "Number", "help": "A text input that takes a number.",
              "default": 1.5, "storage": { "path": ["TextInputs", "fNumber"] }
            }
          ]
        }
      ]
    },
    {
      "pageDisplayName": "Text, spacers and images",
      "help": "Rows that hold no value: texts with and without tags, spacers, and textures at their own size and at the size a row gives.",
      "content": [
        {
          "type": "section", "text": "Texts",
          "content": [
            { "type": "text", "text": "A plain text, wrapped to the width of the rows. It has no html, so a tag in it, as <b>this</b>, is shown as it is written." },
            {
              "type": "text", "html": true,
              "text": "<p align='center'><font size='28'>A title in a larger size</font></p><p>A text with tags: <b>bold</b>, <i>italic</i>, <u>underlined words</u>, and <font color='#FFFFFF'>a color of its own</font>.</p><p align='right'><font size='16'>A note in a smaller size, at the right</font></p>"
            },
            { "type": "text", "text": "A text of two lines.\nIts second line." },
            { "type": "text", "text": { "token": "$ModsConfigVR_Showcase_TextRow", "fallback": "A text of a token, which no translation file has, so it is its fallback." } }
          ]
        },
        {
          "type": "section", "text": "Spacers",
          "content": [
            { "type": "text", "text": "A spacer of one line under this text." },
            { "type": "spacer" },
            { "type": "text", "text": "A spacer of three lines under this text." },
            { "type": "spacer", "numLines": 3 },
            { "type": "text", "text": "The end of the spacers." }
          ]
        },
        {
          "type": "section", "text": "Images",
          "content": [
            { "type": "text", "text": "Swatches at the texture's own size, 256 by 64." },
            { "type": "image", "texture": "ModsConfigVR_Showcase/swatches.dds" },
            { "type": "text", "text": "A checker of 128 by 128, at the size its row gives, 64 by 64." },
            { "type": "image", "texture": "ModsConfigVR_Showcase/checker.dds", "width": 64, "height": 64 },
            { "type": "text", "text": "The checker at a width of 192 alone: its height is of its aspect." },
            { "type": "image", "texture": "ModsConfigVR_Showcase/checker.dds", "width": 192 },
            { "type": "text", "text": "A ruler of 1024 by 64, which is wider than the rows, so it is as wide as they are." },
            { "type": "image", "texture": "ModsConfigVR_Showcase/ruler.dds" }
          ]
        },
        {
          "type": "section", "text": "Shown by a switcher",
          "content": [
            {
              "id": "showPicture", "type": "switcher", "valueType": "bool", "text": "Show the picture", "help": "The text and the image under it are shown while it is on.",
              "default": true, "storage": { "path": ["Rows", "bShowPicture"] }
            },
            { "type": "text", "text": "Shown while Show the picture is on.", "visibleWhen": { "setting": "showPicture", "equals": true } },
            { "type": "image", "texture": "ModsConfigVR_Showcase/checker.dds", "width": 64, "height": 64, "visibleWhen": { "setting": "showPicture", "equals": true } }
          ]
        }
      ]
    },
    {
      "pageDisplayName": "Sections",
      "help": "Sections in sections, each set in under the one it is in.",
      "content": [
        {
          "type": "switcher", "valueType": "bool", "text": "Before any section", "help": "A row of the page itself.",
          "default": true, "storage": { "path": ["Sections", "bBefore"] }
        },
        {
          "type": "section", "text": "Holsters",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "Enable holsters", "help": "A row of the outer section.",
              "default": true, "storage": { "path": ["Sections", "bHolsters"] }
            },
            {
              "type": "section", "text": "Advanced",
              "content": [
                {
                  "type": "slider", "valueType": "float", "text": "Reach", "help": "A row of a section in a section.",
                  "default": 10.0, "valueOptions": { "min": 0, "max": 50, "step": 1 },
                  "storage": { "path": ["Sections", "fReach"] }
                },
                {
                  "type": "section", "text": "Even more",
                  "content": [
                    {
                      "type": "slider", "valueType": "float", "text": "Angle", "help": "A row three sections in.",
                      "default": 45.0, "valueOptions": { "min": 0, "max": 90, "step": 5 },
                      "storage": { "path": ["Sections", "fAngle"] }
                    }
                  ]
                }
              ]
            },
            {
              "type": "slider", "valueType": "float", "text": "Size", "help": "A row of the outer section, after the sections in it.",
              "default": 1.0, "valueOptions": { "min": 0.5, "max": 2, "step": 0.1 },
              "storage": { "path": ["Sections", "fSize"] }
            }
          ]
        },
        {
          "type": "section", "text": "Only a section in it",
          "content": [
            {
              "type": "section", "text": "Inside",
              "content": [
                {
                  "type": "switcher", "valueType": "bool", "text": "In the inner section", "help": "The outer section has no rows of its own.",
                  "default": false, "storage": { "path": ["Sections", "bInside"] }
                }
              ]
            }
          ]
        },
        { "type": "section", "text": "An empty section", "content": [] },
        {
          "type": "switcher", "valueType": "bool", "text": "After the sections", "help": "A row of the last section.",
          "default": false, "storage": { "path": ["Sections", "bAfter"] }
        }
      ]
    },
    {
      "pageDisplayName": "Pages",
      "help": "A page with pages under it, two levels deep.",
      "content": [
        {
          "type": "switcher", "valueType": "bool", "text": "On the page", "help": "A row of the page that has pages under it.",
          "default": true, "storage": { "path": ["Pages", "bTop"] }
        }
      ],
      "pages": [
        {
          "pageDisplayName": "Under a page",
          "help": "A page under the Pages page.",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "One level down", "help": "A row of a page under a page.",
              "default": false, "storage": { "path": ["Pages", "bUnder"] }
            }
          ],
          "pages": [
            {
              "pageDisplayName": "Two levels down",
              "content": [
                {
                  "type": "switcher", "valueType": "bool", "text": "Two levels down", "help": "A row of a page with no help.",
                  "default": false, "storage": { "path": ["Pages", "bDeeper"] }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "pageDisplayName": "Files",
      "help": "Settings of three files: the package's default, the page's, and a section's.",
      "defaultFile": "player",
      "content": [
        {
          "type": "section", "text": "The page's file: a TOML file that is not there yet",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "Player's switcher", "help": "Its file is not there until a Save writes it, so it has its default.",
              "default": true, "storage": { "path": ["Player", "bSwitcher"] }
            },
            {
              "type": "slider", "valueType": "float", "text": "Player's slider", "help": "Its file is not there until a Save writes it, so it has its default.",
              "default": 0.75, "valueOptions": { "min": 0, "max": 1, "step": 0.05 },
              "storage": { "path": ["Player", "fSlider"] }
            }
          ]
        },
        {
          "type": "section", "text": "A section's file: an INI file", "defaultFile": "ini",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "INI switcher", "help": "A key of an INI file, by its section and its key.",
              "default": true, "storage": { "section": "Ini", "key": "bSwitcher" }
            },
            {
              "type": "slider", "valueType": "int", "text": "INI slider", "help": "A key of an INI file, by its section and its key.",
              "default": 5, "valueOptions": { "min": 0, "max": 10, "step": 1 },
              "storage": { "section": "Ini", "key": "iSlider" }
            }
          ]
        },
        {
          "type": "section", "text": "Its own file: the package's default",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "Shipped switcher", "help": "A setting that names its file, which is not the page's.",
              "default": false, "storage": { "file": "showcase", "path": ["Files", "bOwn"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "A value in a table in a table", "help": "A path of three names: its id is bDeep:Files.Tables.",
              "default": true, "storage": { "file": "showcase", "path": ["Files", "Tables", "bDeep"] }
            }
          ]
        },
        {
          "type": "section", "text": "A file whose values are not the settings'", "defaultFile": "invalid",
          "content": [
            {
              "type": "slider", "valueType": "float", "text": "Past its most", "help": "The file has 2.0, and the slider goes from 0 to 1.",
              "default": 0.5, "valueOptions": { "min": 0, "max": 1, "step": 0.05 },
              "storage": { "path": ["Invalid", "fPastMost"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "A text for a switcher", "help": "The file has the text \"yes\", which is not true or false.",
              "default": true, "storage": { "path": ["Invalid", "bText"] }
            },
            {
              "type": "dropdown", "valueType": "string", "text": "No option of its choice", "help": "The file has \"elbow\", which is none of its options.",
              "default": "hip",
              "valueOptions": { "options": [ { "value": "hip", "text": "Hip" }, { "value": "chest", "text": "Chest" } ] },
              "storage": { "path": ["Invalid", "sPlace"] }
            }
          ]
        }
      ]
    },
    {
      "pageDisplayName": "When a change takes effect",
      "help": "Settings that take effect as they are changed, after Save, and after a restart: their own, a section's and the page's.",
      "applies": "save",
      "content": [
        {
          "type": "section", "text": "The page's: after Save",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "After Save", "help": "It has the page's applies.",
              "default": true, "storage": { "path": ["Applies", "bPage"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "As it is changed", "help": "It has its own applies, live.",
              "applies": "live", "default": true, "storage": { "path": ["Applies", "bLive"] }
            }
          ]
        },
        {
          "type": "section", "text": "A section's: after a restart", "applies": "restart",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "After a restart", "help": "It has its section's applies.",
              "default": false, "storage": { "path": ["Applies", "bRestart"] }
            },
            {
              "type": "section", "text": "A section in it",
              "content": [
                {
                  "type": "switcher", "valueType": "bool", "text": "Also after a restart", "help": "It has the applies of the section its section is in.",
                  "default": false, "storage": { "path": ["Applies", "bInner"] }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "pageDisplayName": "Conditions",
      "help": "Rows that are shown and enabled by the values of settings, and by the plugins that are loaded.",
      "content": [
        {
          "type": "section", "text": "The settings they ask of",
          "content": [
            {
              "id": "showRows", "type": "switcher", "valueType": "bool", "text": "Show rows", "help": "The rows of the next section are shown while it is on.",
              "default": true, "storage": { "path": ["Conditions", "bShow"] }
            },
            {
              "id": "enableRows", "type": "switcher", "valueType": "bool", "text": "Enable rows", "help": "The rows of the section after are enabled while it is on.",
              "default": false, "storage": { "path": ["Conditions", "bEnable"] }
            },
            {
              "id": "mode", "type": "dropdown", "valueType": "string", "text": "Mode", "help": "Some rows are shown for some modes.",
              "default": "physical",
              "valueOptions": {
                "options": [
                  { "value": "physical", "text": "Physical" },
                  { "value": "hybrid", "text": "Hybrid" },
                  { "value": "buttons", "text": "Buttons" }
                ]
              },
              "storage": { "path": ["Conditions", "sMode"] }
            },
            {
              "id": "level", "type": "slider", "valueType": "int", "text": "Level", "help": "Some rows are shown above or below a level.",
              "default": 5, "valueOptions": { "min": 0, "max": 10, "step": 1 },
              "storage": { "path": ["Conditions", "iLevel"] }
            }
          ]
        },
        {
          "type": "section", "text": "Shown by a switcher", "visibleWhen": { "setting": "showRows", "equals": true },
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "In the section", "help": "Shown while Show rows is on: the section's condition.",
              "default": false, "storage": { "path": ["Conditions", "bInSection"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "Also in Hybrid", "help": "Shown while Show rows is on and Mode is Hybrid: its own condition and the section's.",
              "default": false, "storage": { "path": ["Conditions", "bHybrid"] },
              "visibleWhen": { "setting": "mode", "equals": "hybrid" }
            }
          ]
        },
        {
          "type": "section", "text": "Enabled by a switcher", "enabledWhen": { "setting": "enableRows", "equals": true },
          "content": [
            {
              "type": "slider", "valueType": "float", "text": "Enabled with the section", "help": "Edited while Enable rows is on.",
              "default": 0.5, "valueOptions": { "min": 0, "max": 1, "step": 0.1 },
              "storage": { "path": ["Conditions", "fEnabled"] }
            },
            {
              "type": "stepper", "valueType": "int", "text": "Also not in Buttons", "help": "Edited while Enable rows is on and Mode is not Buttons.",
              "default": 0, "valueOptions": { "sharedOptions": "hands" },
              "storage": { "path": ["Conditions", "iNotButtons"] },
              "enabledWhen": { "setting": "mode", "notEquals": "buttons" }
            }
          ]
        },
        {
          "type": "section", "text": "Every operator",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "Level below 3", "help": "Shown while Level is less than 3.",
              "default": false, "storage": { "path": ["Conditions", "bLessThan"] },
              "visibleWhen": { "setting": "level", "lessThan": 3 }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "Level 5 or below", "help": "Shown while Level is less than or equal to 5.",
              "default": false, "storage": { "path": ["Conditions", "bLessThanOrEqual"] },
              "visibleWhen": { "setting": "level", "lessThanOrEqual": 5 }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "Level above 7", "help": "Shown while Level is greater than 7.",
              "default": false, "storage": { "path": ["Conditions", "bGreaterThan"] },
              "visibleWhen": { "setting": "level", "greaterThan": 7 }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "Level 5 or above", "help": "Shown while Level is greater than or equal to 5.",
              "default": false, "storage": { "path": ["Conditions", "bGreaterThanOrEqual"] },
              "visibleWhen": { "setting": "level", "greaterThanOrEqual": 5 }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "Physical or Hybrid", "help": "Shown while Mode is one of Physical and Hybrid.",
              "default": false, "storage": { "path": ["Conditions", "bOneOf"] },
              "visibleWhen": { "setting": "mode", "oneOf": ["physical", "hybrid"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "Not Physical", "help": "Shown while Mode is none of Physical.",
              "default": false, "storage": { "path": ["Conditions", "bNotOneOf"] },
              "visibleWhen": { "setting": "mode", "notOneOf": ["physical"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "Any of two", "help": "Shown while Show rows is off or Level is 10.",
              "default": false, "storage": { "path": ["Conditions", "bAny"] },
              "visibleWhen": { "any": [ { "setting": "showRows", "equals": false }, { "setting": "level", "equals": 10 } ] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "All but one", "help": "Shown while Show rows is on and Mode is not Hybrid.",
              "default": false, "storage": { "path": ["Conditions", "bAllNot"] },
              "visibleWhen": { "all": [ { "setting": "showRows", "equals": true }, { "not": { "setting": "mode", "equals": "hybrid" } } ] }
            }
          ]
        },
        {
          "type": "section", "text": "Plugins",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "With Fallout4.esm", "help": "Shown while the game plugin Fallout4.esm is loaded, which it always is.",
              "default": false, "storage": { "path": ["Conditions", "bGamePlugin"] },
              "visibleWhen": { "plugin": "Fallout4.esm" }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "Without a missing plugin", "help": "Shown while the game plugin NoSuchPlugin.esp is not loaded.",
              "default": false, "storage": { "path": ["Conditions", "bNoGamePlugin"] },
              "visibleWhen": { "not": { "plugin": "NoSuchPlugin.esp" } }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "Never: a missing plugin", "help": "Shown while the game plugin NoSuchPlugin.esp is loaded, so it is not.",
              "default": false, "storage": { "path": ["Conditions", "bMissingGamePlugin"] },
              "visibleWhen": { "plugin": "NoSuchPlugin.esp" }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "With FRIK", "help": "Shown while the F4SE plugin F4VRBody, which is FRIK, is loaded.",
              "default": false, "storage": { "path": ["Conditions", "bF4sePlugin"] },
              "visibleWhen": { "f4sePlugin": "F4VRBody" }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "Enabled without a missing F4SE plugin", "help": "Edited while the F4SE plugin NoSuchPlugin is not loaded.",
              "default": false, "storage": { "path": ["Conditions", "bNoF4sePlugin"] },
              "enabledWhen": { "not": { "f4sePlugin": "NoSuchPlugin" } }
            }
          ]
        }
      ]
    },
    {
      "pageDisplayName": { "token": "$ModsConfigVR_Showcase_Texts", "fallback": "Texts" },
      "help": { "token": "$ModsConfigVR_Showcase_TextsHelp", "fallback": "Plain texts, tokens with a fallback, and a token with none." },
      "content": [
        {
          "type": "section", "text": { "token": "$ModsConfigVR_Showcase_Forms", "fallback": "The three forms of a text" },
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "Plain text", "help": "A text as it is written.",
              "default": true, "storage": { "path": ["Texts", "bPlain"] }
            },
            {
              "type": "switcher", "valueType": "bool",
              "text": { "token": "$ModsConfigVR_Showcase_Fallback", "fallback": "A token with a fallback" },
              "help": { "token": "$ModsConfigVR_Showcase_FallbackHelp", "fallback": "No translation file has its token, so it is its fallback." },
              "default": true, "storage": { "path": ["Texts", "bFallback"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "$ModsConfigVR_Showcase_NoFallback",
              "help": "A token with no fallback, which no translation file has, is shown as it is written.",
              "default": true, "storage": { "path": ["Texts", "bToken"] }
            }
          ]
        }
      ]
    },
    {
      "pageDisplayName": "Mistakes",
      "help": "What a package can get wrong: each row says what, and the log has the error.",
      "content": [
        {
          "type": "section", "text": "Storage",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "No such file", "help": "Its storage names a file the package does not have.",
              "default": true, "storage": { "file": "missing", "path": ["Mistakes", "bNoFile"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "A file that is left out", "help": "Its file goes up out of its root.",
              "default": true, "storage": { "file": "outside", "path": ["Mistakes", "bOutside"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "No storage", "help": "It does not say where its value is kept.",
              "default": true
            }
          ]
        },
        {
          "type": "section", "text": "Settings",
          "content": [
            {
              "type": "slider", "valueType": "float", "text": "No default", "help": "It has no default, so it has no Reset.",
              "valueOptions": { "min": 0, "max": 10, "step": 1 }, "storage": { "path": ["Mistakes", "fNoDefault"] }
            },
            {
              "type": "slider", "valueType": "int", "text": "A default of another type", "help": "Its default is not a whole number.",
              "default": 2.5, "valueOptions": { "min": 0, "max": 10, "step": 1 }, "storage": { "path": ["Mistakes", "iWrongDefault"] }
            },
            {
              "type": "slider", "valueType": "float", "text": "A default outside its range", "help": "Its default is not from 0 to 10, so it has no Reset.",
              "default": 20.0, "valueOptions": { "min": 0, "max": 10, "step": 1 }, "storage": { "path": ["Mistakes", "fOutsideDefault"] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "An applies that is not one", "help": "Its applies is not live, save or restart, so it has the package's.",
              "applies": "never", "default": true, "storage": { "path": ["Mistakes", "bApplies"] }
            },
            {
              "id": "bSwitcher:Main", "type": "switcher", "valueType": "bool", "text": "An id another setting has",
              "help": "Its id is the one the front page's switcher has from its path.",
              "default": true, "storage": { "path": ["Mistakes", "bSameId"] }
            }
          ]
        },
        {
          "type": "section", "text": "Choices",
          "content": [
            {
              "type": "dropdown", "valueType": "int", "text": "No options", "help": "It has no options, so it is disabled.",
              "default": 0, "storage": { "path": ["Mistakes", "iNoOptions"] }
            },
            {
              "type": "stepper", "valueType": "int", "text": "No such shared list", "help": "It names a shared list the package does not have, so it has no options.",
              "default": 0, "valueOptions": { "sharedOptions": "feet" }, "storage": { "path": ["Mistakes", "iNoList"] }
            },
            {
              "type": "dropdown", "valueType": "string", "text": "Options of another type", "help": "Of its four options, a text and a number are left out: they are not texts it stores.",
              "default": "b",
              "valueOptions": { "options": ["A place", { "value": 1, "text": "A number" }, { "value": "b", "text": "B" }, { "value": "c", "text": "C" }] },
              "storage": { "path": ["Mistakes", "sWrongOptions"] }
            },
            {
              "type": "dropdown", "valueType": "string", "text": "A default that is no option", "help": "Its default is none of its options, so it has no Reset.",
              "default": "d", "valueOptions": { "options": [ { "value": "a", "text": "A" }, { "value": "b", "text": "B" } ] },
              "storage": { "path": ["Mistakes", "sNoOptionDefault"] }
            }
          ]
        },
        {
          "type": "section", "text": "Conditions",
          "content": [
            {
              "type": "switcher", "valueType": "bool", "text": "No such setting", "help": "Its condition names a setting the package does not have, so it is shown.",
              "default": true, "storage": { "path": ["Mistakes", "bNoSetting"] },
              "visibleWhen": { "setting": "missing", "equals": true }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "A value of another type", "help": "Its condition compares a switcher with a number, so it is shown.",
              "default": true, "storage": { "path": ["Mistakes", "bWrongType"] },
              "visibleWhen": { "setting": "showRows", "equals": 1 }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "An order of a text", "help": "Its condition asks whether a text is above a number, so it is enabled.",
              "default": true, "storage": { "path": ["Mistakes", "bTextOrder"] },
              "enabledWhen": { "setting": "mode", "greaterThan": 1 }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "A part that is not one", "help": "One part of its condition names no setting, so all of it is left out, and it is shown.",
              "default": true, "storage": { "path": ["Mistakes", "bBadPart"] },
              "visibleWhen": { "all": [ { "setting": "showRows", "equals": false }, { "setting": "missing", "equals": true } ] }
            },
            {
              "type": "switcher", "valueType": "bool", "text": "No operator", "help": "Its condition names a setting and does not say how it is compared, so it is shown.",
              "default": true, "storage": { "path": ["Mistakes", "bNoOperator"] },
              "visibleWhen": { "setting": "showRows", "is": false }
            }
          ]
        },
        {
          "type": "section", "text": "Rows",
          "content": [
            { "type": "colour", "text": "A type no menu knows", "help": "A row of a type that is not one." },
            { "text": "A row with no type", "help": "A row that does not say what it is." }
          ]
        },
        {
          "type": "section", "text": "Images",
          "content": [
            { "type": "text", "text": "A texture that is not there, at the size its row gives:" },
            { "type": "image", "texture": "ModsConfigVR_Showcase/missing.dds", "width": 256, "height": 64 },
            { "type": "text", "text": "A texture that is not there, with no size:" },
            { "type": "image", "texture": "ModsConfigVR_Showcase/missing.dds" },
            { "type": "text", "text": "An image that names no texture:" },
            { "type": "image" }
          ]
        }
      ]
    }
  ]
}
